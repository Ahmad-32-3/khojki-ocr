#!/bin/sh
# Enable once per clone:  git config core.hooksPath hooks
# Your own commits: no scans, unit tests pass, and (when the scans are on this machine) real-data checks pass.
if git diff --cached --name-only | grep -E '\.(pdf|png|jpe?g|webp)$|^data/pages/|^gt/lines/'; then
  echo "pre-commit: scan files are staged (listed above). The brief says to use the pages for this exercise only." >&2
  exit 1
fi
python -m pytest -q || { echo "pre-commit: tests failed, commit blocked." >&2; exit 1; }
python -X utf8 gt/check_real.py --no-log || { echo "pre-commit: real-data checks failed, commit blocked." >&2; exit 1; }
